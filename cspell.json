{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-GB",
  "ignorePaths": [
    "**/*.asc",
    "**/*.gif",
    "**/*.ico",
    "**/*.jpeg",
    "**/*.jpg",
    "**/*.pdf",
    "**/*.pem",
    "**/*.png",
    "**/*.svg",
    "**/*.tsbuildinfo",
    "**/*.webp",
    "**/*.woff",
    "**/*.woff2",
    "**/.idea/**",
    "**/.next/**",
    "**/certificates/**",
    "**/coverage/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/out/**",
    "**/playwright-report/**",
    "**/test-results/**",
    ".claude/**",
    ".env*",
    "bun.lock"
  ],
  "ignoreRegExpList": [
    "/#[0-9a-fA-F]{3,8}/",
    "/#[0-9a-fA-F]{3,8}\\b/g",
    "/[0-9a-f]{7,40}/",
    "/\\\\\\\\b/g",
    "/\\b[0-9a-f]{40}\\b/g",
    "/color\\s*=\\s*\"[0-9a-f]{6}\"/g",
    "/\\boklch\\([^)]*\\)/g",
    "/\\bsha256:[0-9a-f]{64}\\b/g",
    "/oklch\\([^)]*\\)/"
  ],
  "dictionaries": [
    "typescript",
    "node",
    "css",
    "html",
    "softwareTerms",
    "filetypes",
    "companies",
    "bash",
    "npm",
    "fonts",
    "docker",
    "misc",
    "fullstack"
  ],
  "words": [
    "Amazonbot",
    "Applebot",
    "arcanis",
    "armor",
    "armored",
    "automerged",
    "backrefs",
    "BADSIG",
    "BibTeX",
